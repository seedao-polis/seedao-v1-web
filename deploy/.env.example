# Host port (must match Nginx proxy_pass). Default 3080 when 3000 is taken by another app.
HOST_PORT=3080

# Pre-built image from GitHub Actions (required).
# After first successful workflow run, replace OWNER/REPO with your GitHub path (lowercase).
# Examples:
#   WEB_IMAGE=ghcr.io/seedao-polis/seedao-v1-web:latest
#   WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/seedao-website:latest
WEB_IMAGE=ghcr.io/OWNER/REPO:latest
